end

local function UpdateESP(Esp)
	local OtherPlayer = Esp.Player
	local Char = OtherPlayer.Character

	local function HideAll()
		Esp.Box.Visible = false
		Esp.Name.Visible = false
		Esp.Distance.Visible = false
		Esp.Health.Visible = false
		Esp.Tracer.Visible = false
	end

	if not Char or not Char:FindFirstChild("HumanoidRootPart") or not Char:FindFirstChild("Humanoid") then
		HideAll()
		return
	end

	if IsTeamMate(OtherPlayer) then
		HideAll()
		return
	end

	local HRP = Char.HumanoidRootPart
	local Head = Char:FindFirstChild("Head")
	local Hum = Char.Humanoid
	local Vector, OnScreen = Camera:WorldToViewportPoint(HRP.Position)

	if OnScreen then
		local HeadPos = Camera:WorldToViewportPoint(Head.Position + Vector3.new(0, 0.5, 0))
		local LegPos = Camera:WorldToViewportPoint(HRP.Position - Vector3.new(0, 3, 0))

		local Height = math.abs(HeadPos.Y - LegPos.Y)
		local Width = Height / 2

		if Config.ESPEnabled and Config.BoxESP then
			Esp.Box.Size = Vector2.new(Width, Height)
			Esp.Box.Position = Vector2.new(Vector.X - Width / 2, Vector.Y - Height / 2)
			Esp.Box.Visible = true
		else
			Esp.Box.Visible = false
		end

		if Config.ESPEnabled and Config.NameESP then
			Esp.Name.Text = OtherPlayer.Name
			Esp.Name.Position = Vector2.new(Vector.X, HeadPos.Y - 20)
			Esp.Name.Visible = true
		else
			Esp.Name.Visible = false
		end

		if Config.ESPEnabled and Config.DistanceESP and Player.Character:FindFirstChild("HumanoidRootPart") then
			local Distance = math.floor((HRP.Position - Player.Character.HumanoidRootPart.Position).Magnitude)
			Esp.Distance.Text = Distance .. "m"
			Esp.Distance.Position = Vector2.new(Vector.X, LegPos.Y + 5)
			Esp.Distance.Visible = true
		else
			Esp.Distance.Visible = false
		end

		if Config.ESPEnabled and Config.HealthESP then
			local Health = math.floor(Hum.Health)
			local MaxHealth = math.floor(Hum.MaxHealth)
			Esp.Health.Text = Health .. "/" .. MaxHealth
			Esp.Health.Position = Vector2.new(Vector.X, Vector.Y)
			Esp.Health.Color = Color3.fromRGB(255 - (Health / MaxHealth) * 255, (Health / MaxHealth) * 255, 0)
			Esp.Health.Visible = true
		else
			Esp.Health.Visible = false
		end

		if Config.ESPEnabled and Config.TracerESP then
			Esp.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
			Esp.Tracer.To = Vector2.new(Vector.X, Vector.Y)
			Esp.Tracer.Visible = true
		else
			Esp.Tracer.Visible = false
		end
	else
		HideAll()
	end
end

local function RemoveESP(OtherPlayer)
	if ESPObjects[OtherPlayer] then
		if ESPObjects[OtherPlayer].Box then ESPObjects[OtherPlayer].Box:Remove() end
		if ESPObjects[OtherPlayer].Name then ESPObjects[OtherPlayer].Name:Remove() end
		if ESPObjects[OtherPlayer].Distance then ESPObjects[OtherPlayer].Distance:Remove() end
		if ESPObjects[OtherPlayer].Health then ESPObjects[OtherPlayer].Health:Remove() end
		if ESPObjects[OtherPlayer].Tracer then ESPObjects[OtherPlayer].Tracer:Remove() end
		ESPObjects[OtherPlayer] = nil
	end
end

local function GetClosestPlayerToMouse()
	local ClosestPlayer = nil
	local ShortestDistance = math.huge
	local MousePos = UserInputService:GetMouseLocation()

	for _, OtherPlayer in pairs(Players:GetPlayers()) do
		if OtherPlayer ~= Player and OtherPlayer.Character and OtherPlayer.Character:FindFirstChild("HumanoidRootPart") then
			if IsTeamMate(OtherPlayer) then continue end

			local TargetPart = GetCharacterPart(OtherPlayer.Character, Config.AimbotTarget)
			if not TargetPart then continue end

			local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
			if OnScreen then
				local Distance = (Vector2.new(MousePos.X, MousePos.Y) - Vector2.new(ScreenPos.X, ScreenPos.Y)).Magnitude
				if Config.UseFOVCircle then
					if Distance < Config.AimbotFOV and Distance < ShortestDistance then
						ClosestPlayer = OtherPlayer
						ShortestDistance = Distance
					end
				else
					if Distance < ShortestDistance then
						ClosestPlayer = OtherPlayer
						ShortestDistance = Distance
					end
				end
			end
		end
	end

	return ClosestPlayer
end

local function GetSilentAimTarget()
	if not Config.SilentAimEnabled then return nil end
	if math.random(1, 100) > Config.HitChance then return nil end

	local ClosestPlayer = nil
	local ShortestDistance = math.huge
	local ClosestPart = nil
	local MousePos = UserInputService:GetMouseLocation()

	for _, OtherPlayer in pairs(Players:GetPlayers()) do
		if OtherPlayer ~= Player and OtherPlayer.Character and OtherPlayer.Character:FindFirstChild("HumanoidRootPart") then
			if IsTeamMate(OtherPlayer) then continue end

			local UseHead = math.random(1, 100) <= Config.HeadshotChance
			local TargetPart = GetCharacterPart(OtherPlayer.Character, UseHead and "Head" or "Torso")
			if not TargetPart then continue end
			if Config.SilentVisibility and not IsVisible(TargetPart) then continue end

			local TargetPos = TargetPart.Position
			if Config.SilentPrediction then
				local HRP = OtherPlayer.Character.HumanoidRootPart
				local Velocity = HRP.AssemblyLinearVelocity or HRP.Velocity
				local Distance = (TargetPos - Camera.CFrame.Position).Magnitude
				local TimeToHit = Distance / 1000
				TargetPos = TargetPos + (Velocity * TimeToHit)
			end

			local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPos)
			if OnScreen then
				local Distance = (Vector2.new(MousePos.X, MousePos.Y) - Vector2.new(ScreenPos.X, ScreenPos.Y)).Magnitude
				if Distance < Config.SilentAimFOV and Distance < ShortestDistance then
					ClosestPlayer = OtherPlayer
					ShortestDistance = Distance
					ClosestPart = TargetPart
				end
			end
		end
	end

	return ClosestPart
end

-- ===== Silent Aim Hook =====
if hookmetamethod then
	local OldNamecall
	OldNamecall = hookmetamethod(game, "__namecall", function(...)
		local Args = { ... }
		local Method = getnamecallmethod()

		if Config.SilentAimEnabled and (Method == "FireServer" or Method == "InvokeServer") then
			local SilentTarget = GetSilentAimTarget()
			if SilentTarget then
				for i, Arg in pairs(Args) do
					if typeof(Arg) == "Vector3" then
						if Config.SilentPrediction and SilentTarget.Parent:FindFirstChild("HumanoidRootPart") then
							local HRP = SilentTarget.Parent.HumanoidRootPart
							local Velocity = HRP.AssemblyLinearVelocity or HRP.Velocity
							local Distance = (SilentTarget.Position - Camera.CFrame.Position).Magnitude
							local TimeToHit = Distance / 1000
							Args[i] = SilentTarget.Position + (Velocity * TimeToHit)
						else
							Args[i] = SilentTarget.Position
						end
					elseif typeof(Arg) == "CFrame" then
						Args[i] = CFrame.new(Camera.CFrame.Position, SilentTarget.Position)
					elseif typeof(Arg) == "Ray" then
						Args[i] = Ray.new(Camera.CFrame.Position, (SilentTarget.Position - Camera.CFrame.Position).Unit * 1000)
					end
				end
			end
		end

		return OldNamecall(...)
	end)
end

-- ===== Main Render Loop (ESP / FOV circles / Aimbot / Movement) =====
local function RenderLoop()
	task.spawn(function()
		while true do
			RunService.RenderStepped:Wait()
			pcall(function()
				-- ESP
				if Config.ESPEnabled then
					for OtherPlayer, Esp in pairs(ESPObjects) do
						if OtherPlayer and OtherPlayer.Parent then
							UpdateESP(Esp)
						else
							RemoveESP(OtherPlayer)
						end
					end
				end

				-- FOV circles
				if FOVCircle then
					local MousePos = UserInputService:GetMouseLocation()
					FOVCircle.Position = Vector2.new(MousePos.X, MousePos.Y)
					FOVCircle.Radius = Config.AimbotFOV
					FOVCircle.Visible = Config.AimbotEnabled and Config.UseFOVCircle
				end

				if SilentAimFOVCircle then
					local MousePos = UserInputService:GetMouseLocation()
					SilentAimFOVCircle.Position = Vector2.new(MousePos.X, MousePos.Y)
					SilentAimFOVCircle.Radius = Config.SilentAimFOV
					SilentAimFOVCircle.Visible = Config.SilentAimEnabled
				end

				-- Aimbot
				local ShouldAim = false
				if Config.UseKeybind then
					ShouldAim = Config.AimbotEnabled and UserInputService:IsKeyDown(Enum.KeyCode[Config.AimbotKey])
				else
					ShouldAim = Config.AimbotEnabled
				end

				if ShouldAim then
					local Target = GetClosestPlayerToMouse()
					if Target and Target.Character then
						local TargetPart = GetCharacterPart(Target.Character, Config.AimbotTarget)
						if TargetPart then
							Camera.CFrame = CFrame.new(Camera.CFrame.Position, TargetPart.Position)
						end
					end
				end

				-- Noclip
				if Config.NoclipEnabled and Player.Character then
					for _, Part in pairs(Player.Character:GetDescendants()) do
						if Part:IsA("BasePart") then
							Part.CanCollide = false
						end
					end
				end

				-- Movement
				if Player.Character and Player.Character:FindFirstChild("Humanoid") then
					local Hum = Player.Character.Humanoid
					if Config.WalkspeedEnabled then
						Hum.WalkSpeed = Config.WalkspeedValue
					else
						Hum.WalkSpeed = OriginalWalkspeed
					end
					if Config.JumpPowerEnabled then
						Hum.JumpPower = Config.JumpPowerValue
					else
						Hum.JumpPower = OriginalJumpPower
					end
				end
			end)
		end
	end)
end

