--==================================================
-- AUTO FARMING
--==================================================

local FarmingGroup = Tabs.Main:AddLeftGroupbox("Auto Farming", "cpu")

FarmingGroup:AddToggle("AutoClickFollowers", {
	Text = "Auto Click Followers",
	Default = false,
	Callback = function(Value)
		CONFIG.AutoClickFollowers = Value
		if Value then
			task.spawn(function()
				while CONFIG.AutoClickFollowers do
					pcall(function()
						local Event = game:GetService("ReplicatedStorage").Remotes.Events.ClickRemote
						Event:FireServer()
					end)
					task.wait(0.001)
				end
			end)
		end
	end,
})

FarmingGroup:AddToggle("AutoBattleTap", {
	Text = "Auto Battle Tap",
	Default = false,
	Callback = function(Value)
		CONFIG.AutoBattleTap = Value
		if Value then
			task.spawn(function()
				while CONFIG.AutoBattleTap do
					pcall(function()
						local Event = game:GetService("ReplicatedStorage").Remotes.Events.BattleTap
						Event:FireServer()
					end)
					task.wait(0.001)
				end
			end)
		end
	end,
})

FarmingGroup:AddToggle("AutoWins", {
	Text = "Auto Wins",
	Default = false,
	Callback = function(Value)
		CONFIG.AutoWins = Value
		if Value then
			task.spawn(function()
				while CONFIG.AutoWins do
					pcall(function()
						firetouchinterest(workspace.Worlds.World1.Map.Win.Lane21.WinPart, Character.HumanoidRootPart, 0)
						task.wait(0.001)
						firetouchinterest(workspace.Worlds.World1.Map.Win.Lane21.WinPart, Character.HumanoidRootPart, 1)
					end)
					task.wait(0.01)
				end
			end)
		end
	end,
})

FarmingGroup:AddToggle("AutoWinsWorld2", {
	Text = "Auto Wins [World 2]",
